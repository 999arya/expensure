# Production example: export these variables in your host.
# Local development loads .env automatically; existing environment values win.
DJANGO_SETTINGS_MODULE=config.production
DJANGO_SECRET_KEY=replace-with-a-random-secret-at-least-50-characters-long
DJANGO_ALLOWED_HOSTS=finance.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://finance.example.com
DATABASE_URL=postgresql://finance:replace-password@db-host:5432/finance
DATABASE_SSL_REQUIRE=true
TRUST_PROXY_HTTPS=false
DJANGO_DEFAULT_FROM_EMAIL=noreply@example.com
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=replace
EMAIL_HOST_PASSWORD=replace
# Optional; only used with the user's per-request opt-in.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
AI_DAILY_LIMIT=20

# Telegram Bot (Phase 1: Login only)
# Get from @BotFather and set up Login Widget for OIDC.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
